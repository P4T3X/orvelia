# Same Supabase project as the web app (anon key is public by design; RLS protects data).
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The deployed web app; the mobile app calls its /api/mobile/* endpoints (scanner, assistant).
EXPO_PUBLIC_API_URL=https://<domain>
# Set by `eas init` (needed for push tokens).
EAS_PROJECT_ID=
