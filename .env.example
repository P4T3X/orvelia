# Copy to apps/web/.env.local and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).

# Public: safe to expose in the browser. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public base URL of the web app (used for auth email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never import it in client code.
# Not required in Phase 1; reserved for webhooks, account deletion and admin jobs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Document intelligence (Phase 3) ---
# gateway = real extraction through the Vercel AI Gateway (production)
# fixture = deterministic test data for local development only (refused when VERCEL_ENV=production)
# leave empty = the scanner still uploads files and the user enters data by hand
ORVELIA_AI_PROVIDER=
# Model with vision + PDF input, as "provider/model". Pick the exact id from the
# AI Gateway model list (https://vercel.com/ai-gateway/models).
ORVELIA_EXTRACTION_MODEL=
# Local development only; on Vercel the project's OIDC token is used automatically.
AI_GATEWAY_API_KEY=

# --- Automation (Phase 4) ---
# Protects /api/cron/reminders. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Transactional email via Resend. Without these, reminders still reach the in-app inbox.
RESEND_API_KEY=
EMAIL_FROM="ORVELIA <avisos@tu-dominio.com>"

# --- ORVELIA AI (Phase 5) ---
# Model with tool calling, "provider/model". Falls back to ORVELIA_EXTRACTION_MODEL.
ORVELIA_ASSISTANT_MODEL=

# --- Billing: Mercado Pago Suscripciones (Phase 6) ---
# Access token of your Mercado Pago application (TEST-... in sandbox, APP_USR-... in production).
MERCADOPAGO_ACCESS_TOKEN=
# Webhook secret: Tus integraciones > Webhooks > Configurar notificaciones.
# Events: "Planes y suscripciones". URL: https://<your-domain>/api/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=
