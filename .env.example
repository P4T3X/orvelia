# Copy to apps/web/.env.local and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).

# Public: safe to expose in the browser. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public base URL of the web app (used for auth email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never import it in client code.
# Not required in Phase 1; reserved for webhooks, account deletion and admin jobs.
SUPABASE_SERVICE_ROLE_KEY=
